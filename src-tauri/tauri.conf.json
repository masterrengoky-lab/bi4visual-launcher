{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bi4visual launcher",
  "version": "1.4.2",
  "identifier": "net.bi4visual.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bi4visual launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://mc-heads.net https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "bi4visual",
    "category": "Game",
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "bi4visual launcher: любые версии Minecraft, Fabric, вход через Microsoft или по нику.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/mods/*": "mods/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4MTE1RDBBRDg2QTRFRTYKUldUbVRtcllDbDBSNkQ2YittS25aWVNqYTJYeEdjWWxCYy9NUE53eFR1M3F6WWxpYXVkT0VyZVYK",
      "endpoints": [
        "https://github.com/masterrengoky-lab/bi4visual-launcher/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
