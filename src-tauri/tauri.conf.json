{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KissLauncherVis",
  "version": "0.1.0",
  "identifier": "net.kisslaunchervis.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KissLauncherVis",
        "width": 1300,
        "height": 780,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://mc-heads.net https://cdn.modrinth.com https://media.forgecdn.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "KissLauncherVis",
    "category": "Game",
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "KissLauncherVis: лаунчер Minecraft с модами Modrinth и CurseForge, скинами, косметикой и сборками.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English",
          "Ukrainian"
        ],
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/mods/*": "mods/"
    }
  },
  "mainBinaryName": "KissLauncherVis"
}